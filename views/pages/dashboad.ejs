<link rel="stylesheet" href="/assets/css/dashboad.css">
<div class="wrapper mx-4">
  <h4 class="fw-bold">Dashboad</h4>
  <!-- Hàng 1 -->
  <div class="row cardItem1">
    <div class="col-6 col-md-3 p-2">
      <div class="card border-0 card1 border-0 shadow-sm rounded">
        <div class="wrapper">
          <div class="icon">
            <i class="bi bi-bank"></i>
          </div>
          <div class="text text-center">
            <p class="m-0">9.500.000 VNĐ</p>
            <span>Tổng</span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 p-2">
      <div class="card border-0 card1 shadow-sm rounded">
        <div class="wrapper">
          <div class="icon">
            <i class="bi bi-cart-check"></i>
          </div>
          <div class="text text-center">
            <p class="m-0">5.300.000 VNĐ</p>
            <span>Chi tiêu</span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 p-2">
      <div class="card border-0 card1 shadow-sm rounded">
        <div class="wrapper">
          <div class="icon">
            <i class="bi bi-pie-chart"></i>
          </div>
          <div class="text text-center">
            <p class="m-0">15%</p>
            <span>Phần trăm</span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3 p-2">
      <div class="card border-0 card1 shadow-sm rounded">
        <div class="wrapper">
          <div class="icon">
            <i class="bi bi-cash-coin"></i>
          </div>
          <div class="text text-center">
            <p class="m-0">4.120.000 VNĐ</p>
            <span>Tích lũy</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hàng 2 -->
  <div class="row cardItem2 mt-1">
    <div class="col-12 col-md-4 p-2">
      <div class="card border-0 card2 shadow-sm rounded">
        <div
          class="d-flex justify-content-center align-items-center"
          id="chart1"
        ></div>
      </div>
    </div>
    <div class="col-12 col-md-8 p-2">
      <div class="card border-0 card2 shadow-sm rounded">
        <div
          class="d-flex justify-content-center align-items-center"
          id="chart"
        ></div>
      </div>
    </div>
  </div>
  <div class="row cardItem3 mt-1">
    <div class="col-12 p-2">
      <div class="card border-0 card3 shadow-sm rounded">
        <div id="" class="wrapper rounded-3 p-3" style="width: 100%; height: 100%">
          <div class="table-responsive rounded-3" style="max-height: 100%;">
          <table class="table table-striped table-bordered table-hover">
          
              <thead>
                <th>no.</th>
                <th>no.</th>
                <th>no.</th>
                <th>no.</th>
              </thead>
              <tbody></tbody>
            
          </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module" src="/assets/js/dashboad.js"></script>
<script>
  const tbody=document.querySelector('tbody');
  for(let i=0;i<30;i++)
{
  const tr=document.createElement('tr');
  const num=Math.random()*100
  tr.innerHTML=
  `
    <td>${num}</td>
    <td>${num}</td>
    <td>${num}</td>
    <td>${num}</td>
  `
  tbody.appendChild(tr)
}
</script>
